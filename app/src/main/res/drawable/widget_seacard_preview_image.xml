<?xml version="1.0" encoding="utf-8"?>
<!--
    Статичное превью виджета для лончеров, которые не умеют android:previewLayout
    (API < 31, в т.ч. MIUI на Android 10/11). Без android:previewImage лончер
    показывает вместо превью «Виджет не загружен».
    Сетка повторяет widget_seacard: 2 колонки, отступы 12dp, карточки 1.574:1.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Фон виджета. Явный size задаёт intrinsic-размер, если лончер рисует превью
         без setBounds (иначе layer-list может отрисоваться нулевым). -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E6141414" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
            <size
                android:width="250dp"
                android:height="180dp" />
        </shape>
    </item>

    <!-- Верхний ряд -->
    <item
        android:bottom="99dp"
        android:left="12dp"
        android:right="129dp"
        android:top="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:bottom="99dp"
        android:left="129dp"
        android:right="12dp"
        android:top="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Нижний ряд -->
    <item
        android:bottom="22dp"
        android:left="12dp"
        android:right="129dp"
        android:top="89dp">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:bottom="22dp"
        android:left="129dp"
        android:right="12dp"
        android:top="89dp">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>

</layer-list>
